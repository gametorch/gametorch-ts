# Never run dependency lifecycle scripts. This blocks a common supply-chain
# attack vector (malicious preinstall/postinstall hooks). Packages that
# legitimately need a build step must be allowlisted in package.json under
# pnpm.onlyBuiltDependencies.
ignore-scripts=true

# Fail installs on peer-dependency problems instead of silently continuing.
strict-peer-dependencies=true

# Pin the exact versions resolved in the lockfile.
save-exact=true
